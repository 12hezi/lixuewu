<template>
  <view class="page">
    <!-- 数据看板 -->
    <view class="card">
      <text class="card-title">数据看板 <text class="sub">仅管理员可见 · 实时聚合</text></text>
      <view class="chips">
        <view class="chip" v-for="c in chips" :key="c.k">
          <text class="chip-k">{{ c.k }}</text>
          <text class="chip-v" :class="{ hl: c.hl }">{{ c.v }}</text>
        </view>
      </view>
    </view>

    <!-- 库存维护 -->
    <view class="card">
      <text class="card-title">库存维护</text>
      <view class="field">
        <text class="label">房型</text>
        <picker :range="roomNames" @change="onRoomChange">
          <view class="picker">{{ roomNames[roomIndex] || '请选择房型' }} ›</view>
        </picker>
      </view>

      <view class="field">
        <text class="label">批量补库存（开始 / 结束日期）</text>
        <view class="date-row">
          <picker mode="date" :start="today" @change="onStartChange">
            <view class="picker">{{ startDate || '开始日期' }} ›</view>
          </picker>
          <text class="sep">至</text>
          <picker mode="date" :start="today" @change="onEndChange">
            <view class="picker">{{ endDate || '结束日期' }} ›</view>
          </picker>
        </view>
      </view>

      <view class="field">
        <text class="label">每日可售量</text>
        <input class="input" type="number" v-model="initTotal" />
      </view>
      <button class="btn primary" :loading="initing" :disabled="initing" @tap="doInit">批量补库存（幂等）</button>

      <view class="divider"></view>

      <view class="field">
        <text class="label">调整某日可售量</text>
        <view class="date-row">
          <picker mode="date" :start="today" @change="onAdjDateChange">
            <view class="picker">{{ adjDate || '选择日期' }} ›</view>
          </picker>
          <input class="input small" type="number" v-model="adjTotal" placeholder="总量" placeholder-class="ph" />
        </view>
      </view>
      <button class="btn ghost" :loading="adjusting" :disabled="adjusting" @tap="doAdjust">调整当日总量</button>
    </view>

    <!-- 支付流水 -->
    <view class="card">
      <text class="card-title">支付流水 <text class="sub">模拟支付实时写入，可对账</text></text>
      <view class="log" v-for="log in logs" :key="log.id">
        <view class="log-head">
          <text class="mono">{{ log.orderNo }}</text>
          <text class="amount">￥{{ money(log.amount) }}</text>
        </view>
        <view class="log-sub">
          <text>{{ log.username }} · {{ log.payType }} · {{ log.statusText }}</text>
          <text>{{ log.createTime }}</text>
        </view>
      </view>
      <view class="empty" v-if="!loadingLogs && logs.length === 0">
        <text>暂无支付流水</text>
      </view>
      <view class="load-more" v-if="logs.length > 0" @tap="loadLogs(false)">
        <text>{{ loadingLogs ? '加载中...' : (finished ? '没有更多了' : '加载更多') }}</text>
      </view>
    </view>

    <!-- 评价管理 -->
    <view class="card">
      <text class="card-title">评价管理 <text class="sub">上架 / 下架 / 删除用户评价</text></text>
      <picker :range="roomNames" @change="onAdmRoomChange">
        <view class="picker">{{ roomNames[admRoomIndex] || '全部房型' }} ›</view>
      </picker>
      <view class="log" v-for="r in admReviews" :key="r.id">
        <view class="log-head">
          <text class="mono">{{ r.orderNo }}</text>
          <text class="stars">{{ starText(r.score) }}</text>
        </view>
        <view class="log-sub">
          <text>{{ r.userNickname }} · {{ r.roomTypeName }}</text>
          <text>{{ r.createTime }}</text>
        </view>
        <view class="rev-content" v-if="r.content">{{ r.content }}</view>
        <view class="rev-ops">
          <text class="badge2" :class="r.status === 1 ? 'on' : 'off'">{{ r.status === 1 ? '显示中' : '已隐藏' }}</text>
          <button class="mini-btn" :class="r.status === 1 ? 'ghost' : 'primary'" size="mini" @tap="toggleReview(r)">{{ r.status === 1 ? '隐藏' : '恢复显示' }}</button>
          <button class="mini-btn del" size="mini" @tap="deleteReview(r)">删除</button>
        </view>
      </view>
      <view class="empty" v-if="admReviews.length === 0">
        <text>暂无评价</text>
      </view>
      <view class="load-more" v-if="admReviews.length > 0" @tap="loadAdmReviews(false)">
        <text>{{ loadingAdm ? '加载中...' : (admFinished ? '没有更多了' : '加载更多') }}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { get, post, put, del } from '@/common/request.js'
import { todayStr, addDays, money, toast } from '@/common/util.js'

export default {
  data() {
    return {
      roomTypes: [],
      roomIndex: 0,
      today: '',
      startDate: '',
      endDate: '',
      initTotal: '10',
      adjDate: '',
      adjTotal: '10',
      initing: false,
      adjusting: false,
      logs: [],
      pageNum: 1,
      pageSize: 10,
      loadingLogs: false,
      finished: false,
      chips: [
        { k: '订单总数', v: '-', hl: true },
        { k: '累计实付金额', v: '-' },
        { k: '今日新增订单', v: '-' },
        { k: '今日支付金额', v: '-' },
        { k: '待支付/已入住/已离店', v: '-' },
        { k: '在售房型/注册用户', v: '-' },
        { k: '评价总数/平均分', v: '-' },
        { k: '已占用间夜', v: '-' }
      ],
      admRoomIndex: 0,
      admReviews: [],
      admPageNum: 1,
      admPageSize: 10,
      loadingAdm: false,
      admFinished: false
    }
  },
  computed: {
    roomNames() {
      const names = this.roomTypes.map((r) => r.name + '（' + money(r.price) + '/晚）')
      return ['全部房型'].concat(names)
    }
  },
  onLoad() {
    this.today = todayStr()
    this.startDate = addDays(this.today, 1)
    this.endDate = addDays(this.today, 60)
    this.loadRooms()
    this.loadLogs(true)
    this.loadAdmReviews(true)
    this.loadOverview()
  },
  methods: {
    money(v) {
      return money(v)
    },
    starText(score) {
      const s = Math.round(score || 0)
      let text = ''
      for (let i = 1; i <= 5; i++) {
        text += i <= s ? '★' : '☆'
      }
      return text
    },
    loadRooms() {
      get('/api/room/types')
        .then((types) => {
          this.roomTypes = types || []
        })
        .catch((err) => toast(err.message))
    },
    loadOverview() {
      get('/api/stats/admin/overview')
        .then((o) => {
          this.chips[0].v = o.totalOrders
          this.chips[1].v = '￥' + money(o.paidAmount)
          this.chips[2].v = o.todayOrders
          this.chips[3].v = '￥' + money(o.todayPaidAmount)
          this.chips[4].v = o.pendingOrders + ' / ' + o.checkedIn + ' / ' + o.checkedOut
          this.chips[5].v = o.roomTypes + ' / ' + o.totalUsers
          this.chips[6].v = o.totalReviews + ' 条 / ' + o.avgScore + ' 分'
          this.chips[7].v = o.bookedRoomNights
        })
        .catch((err) => {
          if (err.message.indexOf('403') >= 0) {
            toast('仅管理员可查看数据看板')
          }
        })
    },
    onRoomChange(e) {
      this.roomIndex = Number(e.detail.value)
    },
    onStartChange(e) {
      this.startDate = e.detail.value
    },
    onEndChange(e) {
      this.endDate = e.detail.value
    },
    onAdjDateChange(e) {
      this.adjDate = e.detail.value
    },
    doInit() {
      const roomTypeId = this.roomTypes[this.roomIndex] && this.roomTypes[this.roomIndex].id
      const total = Number(this.initTotal)
      if (!roomTypeId || !this.startDate || !this.endDate || this.endDate < this.startDate || !total) {
        toast('请完整填写房型、日期范围与可售量')
        return
      }
      this.initing = true
      post('/api/inventory/init?roomTypeId=' + roomTypeId + '&startDate=' + this.startDate +
        '&endDate=' + this.endDate + '&total=' + total)
        .then(() => toast('库存补量完成（幂等）', 'success'))
        .catch((err) => toast(err.message))
        .finally(() => {
          this.initing = false
        })
    },
    doAdjust() {
      const roomTypeId = this.roomTypes[this.roomIndex] && this.roomTypes[this.roomIndex].id
      const total = Number(this.adjTotal)
      if (!roomTypeId || !this.adjDate || !total) {
        toast('请填写房型、日期与总量')
        return
      }
      this.adjusting = true
      put('/api/inventory/total?roomTypeId=' + roomTypeId + '&date=' + this.adjDate + '&total=' + total)
        .then(() => toast('当日可售量已更新', 'success'))
        .catch((err) => toast(err.message))
        .finally(() => {
          this.adjusting = false
        })
    },
    loadLogs(reset) {
      if (this.loadingLogs) return
      if (reset) {
        this.pageNum = 1
        this.logs = []
        this.finished = false
      }
      this.loadingLogs = true
      get('/api/payment/logs', { pageNum: this.pageNum, pageSize: this.pageSize })
        .then((page) => {
          const records = page.records || []
          this.logs = reset ? records : this.logs.concat(records)
          this.finished = records.length < this.pageSize
        })
        .catch((err) => {
          if (err.message.indexOf('403') >= 0) {
            toast('仅管理员可查看支付流水')
          } else {
            toast(err.message)
          }
        })
        .finally(() => {
          this.loadingLogs = false
        })
    },
    onAdmRoomChange(e) {
      this.admRoomIndex = Number(e.detail.value)
      this.admPageNum = 1
      this.loadAdmReviews(true)
    },
    loadAdmReviews(reset) {
      if (this.loadingAdm) return
      if (reset) {
        this.admPageNum = 1
        this.admReviews = []
        this.admFinished = false
      }
      this.loadingAdm = true
      const params = { pageNum: this.admPageNum, pageSize: this.admPageSize }
      if (this.admRoomIndex > 0 && this.roomTypes[this.admRoomIndex - 1]) {
        params.roomTypeId = this.roomTypes[this.admRoomIndex - 1].id
      }
      get('/api/review/admin/page', params)
        .then((page) => {
          const records = page.records || []
          this.admReviews = reset ? records : this.admReviews.concat(records)
          this.admFinished = records.length < this.admPageSize
        })
        .catch((err) => {
          if (err.message.indexOf('403') >= 0) {
            toast('仅管理员可管理评价')
          } else {
            toast(err.message)
          }
        })
        .finally(() => {
          this.loadingAdm = false
        })
    },
    toggleReview(r) {
      put('/api/review/' + r.id + '/status?status=' + (r.status === 1 ? 0 : 1))
        .then(() => {
          toast(r.status === 1 ? '评价已隐藏' : '评价已恢复显示', 'success')
          this.loadAdmReviews(true)
          this.loadOverview()
        })
        .catch((err) => toast(err.message))
    },
    deleteReview(r) {
      uni.showModal({
        title: '删除评价',
        content: '删除后不可恢复，确定删除该评价吗？',
        success: (res) => {
          if (!res.confirm) return
          del('/api/review/' + r.id)
            .then(() => {
              toast('评价已删除', 'success')
              this.loadAdmReviews(true)
              this.loadOverview()
            })
            .catch((err) => toast(err.message))
        }
      })
    }
  }
}
</script>

<style scoped>
.page {
  padding: 24rpx;
  box-sizing: border-box;
  background: #f6f2ec;
  min-height: 100vh;
}
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(80, 60, 40, 0.06);
}
.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2f2a26;
  margin-bottom: 20rpx;
}
.card-title .sub {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a8078;
}

/* 数据看板 */
.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.chip {
  flex: 1 1 300rpx;
  background: #faf7f2;
  border: 2rpx solid #ece5db;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
  box-sizing: border-box;
}
.chip-k {
  display: block;
  font-size: 22rpx;
  color: #8a8078;
}
.chip-v {
  display: block;
  margin-top: 8rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #2f2a26;
}
.chip-v.hl {
  color: #8b5e3c;
}

/* 评价管理 */
.stars {
  font-size: 24rpx;
  color: #d99a2b;
  letter-spacing: 2rpx;
}
.rev-content {
  margin-top: 10rpx;
  background: #faf7f2;
  border-radius: 12rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #4a423b;
  line-height: 1.6;
}
.rev-ops {
  margin-top: 14rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.badge2 {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 20rpx;
}
.badge2.on {
  background: #eaf3ec;
  color: #4a7c59;
}
.badge2.off {
  background: #f0efec;
  color: #8a8078;
}
.mini-btn {
  margin: 0;
  height: 52rpx;
  line-height: 52rpx;
  font-size: 22rpx;
  padding: 0 22rpx;
  border-radius: 26rpx;
}
.mini-btn::after {
  border: none;
}
.mini-btn.primary {
  background: #8b5e3c;
  color: #fff;
}
.mini-btn.ghost {
  background: #fff;
  color: #8b5e3c;
  border: 2rpx solid #dcc9b2;
}
.mini-btn.del {
  background: #fbeeee;
  color: #b4534b;
}

.field {
  margin-bottom: 20rpx;
}
.label {
  display: block;
  font-size: 24rpx;
  color: #8a8078;
  margin-bottom: 10rpx;
}
.picker {
  height: 84rpx;
  line-height: 84rpx;
  background: #faf7f2;
  border: 2rpx solid #ece5db;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 27rpx;
  color: #2f2a26;
}
.date-row {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.date-row .picker {
  flex: 1;
  min-width: 0;
}
.sep {
  font-size: 24rpx;
  color: #8a8078;
  flex: none;
}
.input {
  height: 84rpx;
  line-height: 84rpx;
  background: #faf7f2;
  border: 2rpx solid #ece5db;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #2f2a26;
}
.input.small {
  width: 200rpx;
  flex: none;
}
.ph {
  color: #b8aea4;
}

.btn {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 28rpx;
  border-radius: 40rpx;
  margin-top: 8rpx;
}
.btn::after {
  border: none;
}
.btn.primary {
  background: #8b5e3c;
  color: #fff;
}
.btn.ghost {
  background: #fff;
  color: #8b5e3c;
  border: 2rpx solid #dcc9b2;
}
.divider {
  height: 2rpx;
  background: #f0ebe3;
  margin: 28rpx 0;
}

.log {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f4efea;
}
.log:last-child {
  border-bottom: none;
}
.log-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.mono {
  font-family: Consolas, monospace;
  font-size: 24rpx;
  color: #6b6259;
}
.amount {
  font-size: 30rpx;
  font-weight: 600;
  color: #c47a3c;
}
.log-sub {
  margin-top: 8rpx;
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #8a8078;
}
.empty {
  text-align: center;
  color: #8a8078;
  font-size: 26rpx;
  padding: 60rpx 0;
}
.load-more {
  text-align: center;
  font-size: 24rpx;
  color: #8a8078;
  padding: 24rpx 0 8rpx;
}
</style>
